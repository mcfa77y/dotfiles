[user]
	email = joe@empohealth.com
	name = Joe Lau
[fetch]
	prune = true
[push]
	default = current
[alias]
  delete-stashes = "!f() { git stash list | grep \"delete me\" | awk '{print $1}' | xargs -I {} git stash drop {};};"
	reset-file = "!f() { git checkout main -- \"$1\"; }; f"
	rsoft = reset --soft @{u}
	gpull = !git pull && graphify update .
	base = "!f() { \\\n  cur=$(git rev-parse --abbrev-ref HEAD 2>/dev/null); \\\n  onto_sha=$(git reflog show \"$cur\" -n 25 2>/dev/null | grep \"onto \" | sed -nE \"s/.*onto ([0-9a-f]+).*/\\1/p\" | head -n1); \\\n  if [ -n \"$onto_sha\" ]; then \\\n    full=$(git rev-parse --verify \"$onto_sha\" 2>/dev/null); \\\n    if [ -n \"$full\" ]; then \\\n      m=$(git for-each-ref --format=\"%(objectname) %(refname:short)\" refs/heads refs/remotes/origin | awk -v tgt=\"$full\" -v c=\"$cur\" '$1 == tgt { b=$2; sub(/^origin\\//, \"\", b); if (b != c) { print b; exit } }'); \\\n      if [ -n \"$m\" ]; then echo \"$m\"; return 0; fi; \\\n    fi; \\\n  fi; \\\n  st=$(git stash list -n 25 --format=\"%gs\" 2>/dev/null | grep -E \"Auto stash before rebase of \\\"?$cur\\\"? onto \\\"?[^\\\" ]+\\\"?\" | sed -nE \"s/.*onto \\\"?([^\\\" ]+)\\\"?.*/\\1/p\" | head -n1); \\\n  if [ -n \"$st\" ]; then \\\n    st_clean=\"${st#origin/}\"; \\\n    if git show-ref --verify --quiet \"refs/heads/$st_clean\" || git show-ref --verify --quiet \"refs/remotes/origin/$st_clean\"; then \\\n      echo \"$st_clean\"; return 0; \\\n    fi; \\\n  fi; \\\n  cr=$(git reflog show \"$cur\" 2>/dev/null | sed -nE \"s/.*branch: Created from (.*)/\\1/p\" | head -n1); \\\n  if [ -n \"$cr\" ]; then \\\n    cr_clean=\"${cr#origin/}\"; \\\n    if git show-ref --verify --quiet \"refs/heads/$cr_clean\" || git show-ref --verify --quiet \"refs/remotes/origin/$cr_clean\"; then \\\n      echo \"$cr_clean\"; return 0; \\\n    fi; \\\n  fi; \\\n  if command -v gh >/dev/null 2>&1; then \\\n    pr_b=$(gh pr view --json baseRefName -q .baseRefName 2>/dev/null); \\\n    if [ -n \"$pr_b\" ]; then echo \"$pr_b\"; return 0; fi; \\\n  fi; \\\n  up=$(git rev-parse --abbrev-ref --symbolic-full-name \"@{upstream}\" 2>/dev/null | sed -e \"s@^origin/@@\" -e \"s@^refs/heads/@@\"); \\\n  if [ -n \"$up\" ] && [ \"$up\" != \"$cur\" ]; then echo \"$up\"; return 0; fi; \\\n  def=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed \"s@^refs/remotes/origin/@@\"); \\\n  if [ -n \"$def\" ]; then echo \"$def\"; return 0; fi; \\\n  echo \"main\"; \\\n}; f"

[init]
	defaultBranch = main
[core]
	autocrlf = input
  pager = delta
[include]
  path = ~/.gitconfig.local
[pull]
	rebase = true
	ff = false
[credential]
	helper = --help
[gitbutler]
	aiModelProvider = ollama
	aiOllamaModelName = qwen3:14b
[diff]
	; tool = nvimdiff
	tool = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true  # use n and N to move between diff sections
    dark = true      # or `light = true`, or omit for auto-detection

[merge]
    conflictStyle = zdiff3

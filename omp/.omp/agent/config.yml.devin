dev:
  autoqaConsent: granted
symbolPreset: nerd
prewalk:
  enabled: true
autolearn:
  enabled: true
github:
  enabled: true
composer:
  shape: box
spelling:
  autocomplete: false
autoResume: true
startup:
  setupWizard: false
marketplace:
  autoUpdate: auto
memory:

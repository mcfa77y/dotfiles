{
  "name": "cmux-ts",
  "type": "module",
  "private": true,
  "main": "src/index.ts",
  "module": "src/index.ts",
  "bin": {
    "cmux-ts": "src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "bun build --compile --outfile bin/cmux-ts src/index.ts",
    "lint": "oxlint . && biome check .",
    "lint:oxlint": "oxlint .",
    "lint:biome": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "knip": "knip",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "latest",
    "knip": "^6.46.1",
    "oxlint": "^1.94.0"
  }
}

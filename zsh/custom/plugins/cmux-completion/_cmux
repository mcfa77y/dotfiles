_cmux_hooks() {
    _arguments \
        '1: :->sub'
    case $state in
        sub)
            _values 'hooks action' \
                'setup[setup hooks]' \
                'uninstall[uninstall hooks]' \
                'feed[feed events]'
            ;;
    esac
    _arguments '--agent[agent name]:name:'
}

_cmux_vm() {
    _values 'vm action' \
        'base[base VM]' \
        'new[create new VM]' \
        'ls[list VMs]' \
        'status[VM status]' \
        'snapshot[snapshot VM]' \
        'fork[fork VM]' \
        'restore[restore VM]' \
        'rm[remove VM]' \
        'exec[execute on VM]' \
        'shell[shell on VM]' \
        'ssh[SSH to VM]'
}

_cmux_remotes() {
    _values 'remotes action' \
        'list[list remotes]' \
        'add[add remote]' \
        'remove[remove remote]'
    _arguments \
        '--route[host:port]:route:' \
        '--tag[tag]:tag:' \
        '--json[JSON output]'
}

_cmux_todo() {
    _values 'todo action' \
        'add[add todo item]' \
        'list[list todo items]' \
        'check[check todo item]' \
        'uncheck[uncheck todo item]' \
        'start[start todo item]' \
        'rm[remove todo item]' \
        'clear[clear all items]'
    _cmux_target_opts
}

_cmux_workspace() {
    _arguments '1: :->sub'
    case $state in
        sub)
            _values 'workspace action' \
                'status[show or set workspace status]' \
                'set[set workspace status lane]'
            ;;
    esac
    _cmux_target_opts
}

_cmux_diff() {
    _arguments \
        '1:patch-file:_files' \
        '--source[diff source]:source:(unstaged staged branch last-turn)' \
        '--unstaged' '--staged' '--branch' '--last-turn' \
        '--cwd[working directory]:dir:_files -/' \
        '--base[base ref]:ref:' \
        '--title[title]:text:' \
        '--layout[layout]:layout:(split unified)' \
        '--font-size[font size]:points:'
    _cmux_target_opts
}

_cmux_browser() {
    local context state line
    typeset -A opt_args

    _arguments -C \
        '--surface[surface id|ref|index]:id:' \
        '1: :_cmux_browser_subcommands' \
        '*:: :->browser-args'

    case $state in
        browser-args)
            case $line[1] in
                disable|enable|status)
                    ;;
                open|open-split)
                    _arguments '1:url:' '--profile[profile]:profile:'
                    _arguments '--focus[focus]:bool:(true false)'
                    ;;
                goto|navigate)
                    _arguments '1:url:' '--snapshot-after'
                    ;;
                back|forward|reload)
                    _arguments '--snapshot-after'
                    ;;
                react-grab)
                    _values 'react-grab action' toggle
                    _arguments '--surface[id]:id:' '--return-to[terminal surface]:id:'
                    ;;
                devtools)
                    _values 'devtools action' toggle console
                    _arguments '--surface[id]:id:'
                    ;;
                focus-mode)
                    _values 'focus-mode action' enter exit toggle
                    _arguments '--surface[id]:id:'
                    ;;
                design-mode)
                    _values 'design-mode action' enable disable toggle status
                    _arguments '--surface[id]:id:'
                    ;;
                zoom)
                    _values 'zoom action' in out reset
                    _arguments '--surface[id]:id:'
                    ;;
                history)
                    _values 'history action' clear
                    _arguments '--force'
                    ;;
                url|get-url)
                    ;;
                snapshot)
                    _arguments \
                        '--interactive' '-i' \
                        '--cursor' \
                        '--compact' \
                        '--max-depth[depth]:n:' \
                        '--selector[css selector]:css:'
                    ;;
                eval)
                    _arguments '1:script:'
                    ;;
                wait)
                    _arguments \
                        '--selector[css selector]:css:' \
                        '--text[text]:text:' \
                        '--url-contains[text]:text:' \
                        '--load-state[state]:state:(interactive complete)' \
                        '--function[js function]:js:' \
                        '--timeout-ms[timeout]:ms:'
                    ;;
                click|dblclick|hover|focus|check|uncheck|scroll-into-view)
                    _arguments '1:selector:' '--snapshot-after'
                    ;;
                type)
                    _arguments '1:selector:' '2:text:' '--snapshot-after'
                    ;;
                fill)
                    _arguments '1:selector:' '2:text:' '--snapshot-after'
                    ;;
                press|keydown|keyup)
                    _arguments '1:key:' '--snapshot-after'
                    ;;
                select)
                    _arguments '1:selector:' '2:value:' '--snapshot-after'
                    ;;
                scroll)
                    _arguments \
                        '--selector[css selector]:css:' \
                        '--dx[delta x]:n:' \
                        '--dy[delta y]:n:' \
                        '--snapshot-after'
                    ;;
                screenshot)
                    _arguments '--out[output path]:file:_files' '--json'
                    ;;
                get)
                    _values 'get type' url title text html value attr count box styles
                    ;;
                is)
                    _values 'is check' visible enabled checked
                    _arguments '1:selector:'
                    ;;
                find)
                    _values 'find type' role text label placeholder alt title testid first last nth
                    ;;
                frame)
                    _arguments '1:selector:'
                    ;;
                dialog)
                    _values 'dialog action' accept dismiss
                    _arguments '1:text:'
                    ;;
                download)
                    _arguments \
                        '1:action:(wait)' \
                        '--path[download path]:dir:_files -/' \
                        '--timeout-ms[timeout]:ms:'
                    ;;
                profiles)
                    _values 'profiles action' list add rename clear delete
                    _arguments '--force'
                    ;;
                import)
                    _message "import args"
                    ;;
                cookies)
                    _values 'cookies action' get set clear
                    ;;
                storage)
                    _values 'storage type' local session
                    _arguments '1:action:(get set clear)'
                    ;;
                tab)
                    _values 'tab action' new list switch close
                    ;;
                console)
                    _values 'console action' list clear
                    ;;
                errors)
                    _values 'errors action' list clear
                    ;;
                highlight)
                    _arguments '1:selector:'
                    ;;
                state)
                    _values 'state action' save load
                    _arguments '1:path:_files'
                    ;;
                addinitscript)
                    _arguments '1:script:'
                    ;;
                addscript)
                    _arguments '1:script:'
                    ;;
                addstyle)
                    _arguments '1:css:'
                    ;;
                identify)
                    _arguments '--surface[id]:id:'
                    ;;
            esac
            ;;
    esac
}


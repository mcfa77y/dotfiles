#compdef cmux
# zsh completion for cmux CLI — hand-crafted (cmux has no `completion` subcommand)
# Generated from `cmux --help` command list.

_cmux() {
    local context state line
    typeset -A opt_args

    _arguments -C \
        '(-h --help)'{-h,--help}'[show help]' \
        '--password[socket auth password]:password:' \
        '--id-format[output id format]:format:(refs uuids both)' \
        '1: :_cmux_commands' \
        '*:: :->args'

    case $state in
        args)
            case $line[1] in
                welcome|shortcuts|ping|version|capabilities|restore-session)
                    ;;
                reload-config|refresh-surfaces|surface-health|debug-terminals)
                    ;;
                list-windows|current-window|new-window|list-workspaces)
                    ;;
                list-panes|list-pane-surfaces|list-panels|list-notifications)
                    ;;
                current-workspace|sidebar-state|simulate-app-active|popup)
                    ;;
                list-buffers|clear-log|list-log|jump-to-unread)
                    ;;
                disable-browser|enable-browser|browser-status)
                    ;;
                docs)
                    _arguments \
                        '1:topic:(settings shortcuts api browser agents dock sidebars)'
                    ;;
                settings)
                    _arguments \
                        '1: :->sub'
                    case $state in
                        sub)
                            _values 'settings' \
                                'open[open settings UI]' \
                                'path[print settings file path]' \
                                'docs[print settings docs]'
                            ;;
                    esac
                    ;;
                config)
                    _values 'config action' \
                        'doctor' 'check' 'validate' 'path' 'paths' \
                        'docs' 'documentation' 'reload'
                    ;;
                agent-hibernation)
                    _values 'state' on off
                    ;;
                feed)
                    _values 'feed action' tui clear
                    ;;
                themes)
                    _values 'themes action' list set clear
                    ;;
                auth)
                    _values 'auth action' status login logout
                    ;;
                login|logout)
                    ;;
                claude-teams|codex-teams|omo|omx|omc)
                    _message "agent args (passed through)"
                    ;;
                hooks)
                    _cmux_hooks
                    ;;
                vm|cloud)
                    _cmux_vm
                    ;;
                remotes|remote)
                    _cmux_remotes
                    ;;
                ai-accounts)
                    _values 'ai-accounts action' list upload remove
                    ;;
                todo)
                    _cmux_todo
                    ;;
                workspace)
                    _cmux_workspace
                    ;;
                right-sidebar)
                    _values 'right-sidebar action' \
                        toggle show hide focus set mode \
                        files find vault sessions feed dock
                    _cmux_target_opts
                    ;;
                sidebar)
                    _values 'sidebar action' validate reload select open
                    _message "sidebar name"
                    ;;
                set-app-focus)
                    _values 'focus state' active inactive clear
                    ;;
                surface)
                    _arguments \
                        '1:subcommand:(resume)' \
                        '*:: :->resume-args'
                    case $state in
                        resume-args)
                            _values 'resume action' set show get clear
                            _cmux_target_opts
                            ;;
                    esac
                    ;;
                restore)
                    _arguments \
                        '--surface[restore surface]:id:' \
                        '1:kind:' \
                        '2:checkpoint-id:'
                    ;;
                open)
                    _arguments \
                        '*:path-or-url:_files'
                    _cmux_target_opts
                    ;;
                diff)
                    _cmux_diff
                    ;;
                feedback)
                    _arguments \
                        '--email[email]:email:' \
                        '--body[body text]:text:' \
                        '*--image[image path]:file:_files'
                    ;;
                markdown)
                    _arguments \
                        '1:action:(open)' \
                        '2:path:_files' \
                        '--focus[focus]:bool:(true false)'
                    ;;
                events)
                    _arguments \
                        '--after[sequence number]:seq:' \
                        '--cursor-file[cursor file]:file:_files' \
                        '--name[event name]:name:' \
                        '--category[category]:category:' \
                        '--reconnect' \
                        '--limit[number]:n:' \
                        '--no-ack' \
                        '--no-heartbeat'
                    ;;
                rpc)
                    _arguments \
                        '1:method:' \
                        '2:json-params:'
                    ;;
                simulator|ios)
                    _message "simulator subcommand"
                    _cmux_target_opts
                    ;;
                identify)
                    _cmux_target_opts
                    _arguments '--no-caller'
                    ;;
                tree)
                    _arguments '--all'
                    _cmux_target_opts
                    ;;
                top)
                    _arguments '--all' '--processes' \
                        '--sort[sort by]:key:(cpu mem proc)' \
                        '--flat' \
                        '--format[format]:fmt:(tree tsv)'
                    _cmux_target_opts
                    ;;
                memory)
                    _arguments '--all' '--groups[count]:n:'
                    _cmux_target_opts
                    ;;
                focus-window|close-window)
                    _arguments '--window[id|ref]:id:'
                    ;;
                move-workspace-to-window)
                    _arguments '--workspace[id|ref]:id:' '--window[id|ref]:id:'
                    ;;
                reorder-workspace)
                    _arguments \
                        '--workspace[id|ref]:id:' \
                        '--index[position]:n:' \
                        '--before[id|ref]:id:' \
                        '--after[id|ref]:id:' \
                        '--window[id|ref]:id:' \
                        '--dry-run'
                    ;;
                reorder-workspaces)
                    _arguments \
                        '--order[comma-separated order]:order:' \
                        '--window[id|ref]:id:' \
                        '--dry-run'
                    ;;
                workspace-action)
                    _arguments \
                        '--action[action name]:name:' \
                        '--title[title]:text:' \
                        '--color[color]:color:' \
                        '--description[description]:text:'
                    _cmux_target_opts
                    ;;
                move-tab-to-new-workspace)
                    _arguments \
                        '--tab[id|ref]:id:' '--title[text]:text:'
                    _cmux_target_opts
                    ;;
                new-workspace)
                    _arguments \
                        '--name[title]:text:' \
                        '--description[description]:text:' \
                        '--cwd[working directory]:dir:_files -/' \
                        '--command[command]:text:' \
                        '--layout[json layout]:json:' \
                        '--group[group id|ref]:id:' \
                        '--group-placement[placement]:placement:(afterCurrent top end)' \
                        '--group-reference[workspace]:id:'
                    _cmux_target_opts
                    ;;
                ssh|mosh|mosh-tmux|ssh-tmux)
                    _arguments \
                        '1:destination:' \
                        '--name[title]:text:' \
                        '--command[command]:text:' \
                        '--port[port]:n:' \
                        '--identity[identity file]:file:_files' \
                        {-A,--forward-agent} \
                        {-a,--no-forward-agent} \
                        '--ssh-option[ssh option]:opt:' \
                        '--session[session name]:name:' \
                        '--new-window' \
                        '--no-focus'
                    _cmux_target_opts
                    ;;
                ssh-session-list)
                    _arguments '--all-workspaces'
                    _cmux_target_opts
                    ;;
                ssh-session-attach)
                    _arguments \
                        '--session-id[session id]:id:' \
                        '--split[split direction]:dir:(left right up down)'
                    _cmux_target_opts
                    ;;
                ssh-session-cleanup)
                    _arguments \
                        '--session-id[session id]:id:' \
                        '--all'
                    _cmux_target_opts
                    ;;
                remote-daemon-status)
                    _arguments \
                        '--os[os]:os:(darwin linux)' \
                        '--arch[arch]:arch:(arm64 amd64)'
                    ;;
                new-split)
                    _arguments '1:direction:(left right up down)'
                    _cmux_target_opts
                    _arguments '--panel[id|ref]:id:'
                    ;;
                focus-pane)
                    _arguments '--pane[id|ref]:id:'
                    _cmux_target_opts
                    ;;
                new-pane)
                    _arguments \
                        '--type[pane type]:type:(terminal browser simulator)' \
                        '--direction[direction]:dir:(left right up down)' \
                        '--url[url]:url:' \
                        '--profile[profile]:profile:'
                    _cmux_target_opts
                    ;;
                new-surface)
                    _arguments \
                        '--type[surface type]:type:(terminal browser simulator agent-session)' \
                        '--provider[agent provider]:provider:(codex claude opencode)' \
                        '--renderer[renderer]:renderer:(react solid)' \
                        '--url[url]:url:'
                    _cmux_target_opts
                    ;;
                close-surface)
                    _cmux_target_opts
                    ;;
                move-surface)
                    _arguments \
                        '--surface[id|ref]:id:' \
                        '--pane[id|ref]:id:' \
                        '--before[id|ref]:id:' \
                        '--after[id|ref]:id:' \
                        '--index[position]:n:'
                    _cmux_target_opts
                    ;;
                split-off)
                    _arguments \
                        '--surface[id|ref]:id:' \
                        '1:direction:(left right up down)'
                    _cmux_target_opts
                    ;;
                reorder-surface)
                    _arguments \
                        '--surface[id|ref]:id:' \
                        '--index[position]:n:' \
                        '--before[id|ref]:id:' \
                        '--after[id|ref]:id:'
                    _cmux_target_opts
                    ;;
                tab-action)
                    _arguments \
                        '--action[action name]:name:' \
                        '--tab[id|ref]:id:' \
                        '--title[text]:text:' \
                        '--url[url]:url:'
                    _cmux_target_opts
                    ;;
                rename-tab)
                    _arguments '1:title:'
                    _cmux_target_opts
                    ;;
                drag-surface-to-split)
                    _arguments \
                        '--surface[id|ref]:id:' \
                        '1:direction:(left right up down)'
                    _cmux_target_opts
                    ;;
                trigger-flash)
                    _cmux_target_opts
                    ;;
                focus-panel)
                    _arguments '--panel[id|ref]:id:'
                    _cmux_target_opts
                    ;;
                close-workspace|select-workspace)
                    _arguments '--workspace[id|ref]:id:'
                    _cmux_target_opts
                    ;;
                rename-workspace)
                    _arguments '1:title:'
                    _cmux_target_opts
                    ;;
                rename-window)
                    _arguments '1:title:'
                    _cmux_target_opts
                    ;;
                current-workspace)
                    _cmux_target_opts
                    ;;
                read-screen|capture-pane)
                    _arguments '--scrollback' '--lines[n]:n:'
                    _cmux_target_opts
                    ;;
                send)
                    _arguments '1:text:'
                    _cmux_target_opts
                    ;;
                send-key)
                    _arguments '1:key:'
                    _cmux_target_opts
                    ;;
                send-panel)
                    _arguments '--panel[id|ref]:id:' '1:text:'
                    _cmux_target_opts
                    ;;
                send-key-panel)
                    _arguments '--panel[id|ref]:id:' '1:key:'
                    _cmux_target_opts
                    ;;
                notify)
                    _arguments \
                        '--title[title]:text:' \
                        '--subtitle[subtitle]:text:' \
                        '--body[body]:text:'
                    _cmux_target_opts
                    ;;
                dismiss-notification)
                    _arguments '--id[uuid]:uuid:' '--all-read'
                    ;;
                mark-notification-read)
                    _arguments '--id[uuid]:uuid:' '--all'
                    _cmux_target_opts
                    ;;
                open-notification)
                    _arguments '--id[uuid]:uuid:'
                    ;;
                clear-notifications)
                    _cmux_target_opts
                    ;;
                set-status)
                    _arguments \
                        '1:key:' '2:value:' \
                        '--icon[icon name]:name:' \
                        '--color[color]:color:' \
                        '--priority[priority]:n:'
                    _cmux_target_opts
                    ;;
                clear-status)
                    _arguments '1:key:'
                    _cmux_target_opts
                    ;;
                list-status)
                    _cmux_target_opts
                    ;;
                set-progress)
                    _arguments '1:progress:(0.0 0.1 0.2 0.25 0.3 0.4 0.5 0.6 0.7 0.75 0.8 0.9 1.0)' \
                        '--label[label]:text:'
                    _cmux_target_opts
                    ;;
                clear-progress)
                    _cmux_target_opts
                    ;;
                log)
                    _arguments \
                        '--level[level]:level:' \
                        '--source[source name]:name:' \
                        '1:message:'
                    _cmux_target_opts
                    ;;
                simulate-sidebar-drag)
                    _arguments \
                        '--window[id|ref]:id:' \
                        '--from[workspace]:ws:' \
                        '--to[workspace]:ws:' \
                        '--duration-ms[duration]:n:' \
                        '--steps[steps]:n:'
                    ;;
                # tmux compatibility commands
                resize-pane)
                    _arguments \
                        '--pane[id|ref]:id:' \
                        '(-L)-L[resize left]' \
                        '(-R)-R[resize right]' \
                        '(-U)-U[resize up]' \
                        '(-D)-D[resize down]' \
                        '--amount[amount]:n:'
                    _cmux_target_opts
                    ;;
                pipe-pane)
                    _arguments '--command[shell command]:text:'
                    _cmux_target_opts
                    ;;
                wait-for)
                    _arguments \
                        '(-S --signal)'{-S,--signal}'[signal]' \
                        '1:name:' \
                        '--timeout[timeout]:seconds:'
                    ;;
                swap-pane)
                    _arguments \
                        '--pane[id|ref]:id:' \
                        '--target-pane[id|ref]:id:'
                    _cmux_target_opts
                    ;;
                break-pane)
                    _cmux_target_opts
                    ;;
                join-pane)
                    _arguments '--target-pane[id|ref]:id:'
                    _cmux_target_opts
                    ;;
                next-window|previous-window|last-window)
                    _cmux_target_opts
                    ;;
                last-pane)
                    _cmux_target_opts
                    ;;
                find-window)
                    _arguments '--content' '--select' '1:query:'
                    _cmux_target_opts
                    ;;
                clear-history)
                    _cmux_target_opts
                    ;;
                set-hook)
                    _arguments '--list' '--unset[event]:event:' '1:event:' '2:command:'
                    ;;
                bind-key|unbind-key|copy-mode)
                    _message "tmux compat command"
                    ;;
                set-buffer)
                    _arguments '--name[name]:name:' '1:text:'
                    ;;
                paste-buffer)
                    _arguments '--name[name]:name:'
                    _cmux_target_opts
                    ;;
                respawn-pane)
                    _arguments '--command[command]:text:'
                    _cmux_target_opts
                    ;;
                display-message)
                    _arguments '(-p --print)'{-p,--print}'[print]' '1:text:'
                    ;;
                browser)
                    _cmux_browser
                    ;;
                help)
                    _values 'help topic' $(_cmux_command_names)
                    ;;
            esac
            ;;
    esac
}

# Common target options shared by many commands
_cmux_target_opts() {
    _arguments \
        '--workspace[workspace id|ref|index]:id:' \
        '--surface[surface id|ref|index]:id:' \
        '--window[window id|ref|index]:id:' \
        '--focus[focus]:bool:(true false)' \
        '--no-focus'
}

_cmux_command_names() {
    local -a cmds
    cmds=(
        welcome docs settings config shortcuts disable-browser enable-browser
        browser-status agent-hibernation restore restore-session open diff
        feedback feed themes claude-teams codex-teams omo omx omc hooks
        ping version capabilities events auth login logout vm remotes
        ai-accounts rpc simulator ios identify list-windows current-window
        new-window focus-window close-window move-workspace-to-window
        reorder-workspace reorder-workspaces workspace-action workspace
        move-tab-to-new-workspace list-workspaces new-workspace ssh
        mosh mosh-tmux ssh-tmux ssh-session-list ssh-session-attach
        ssh-session-cleanup remote-daemon-status new-split list-panes
        list-pane-surfaces tree top memory focus-pane new-pane new-surface
        close-surface move-surface split-off reorder-surface tab-action
        surface rename-tab drag-surface-to-split refresh-surfaces
        reload-config surface-health debug-terminals trigger-flash
        list-panels focus-panel close-workspace select-workspace
        rename-workspace rename-window current-workspace read-screen
        send send-key send-panel send-key-panel notify list-notifications
        dismiss-notification mark-notification-read open-notification
        jump-to-unread clear-notifications right-sidebar sidebar
        set-status clear-status list-status set-progress clear-progress
        log clear-log list-log sidebar-state set-app-focus
        simulate-app-active simulate-sidebar-drag capture-pane resize-pane
        pipe-pane wait-for swap-pane break-pane join-pane next-window
        previous-window last-window last-pane find-window clear-history
        set-hook popup bind-key unbind-key copy-mode set-buffer
        list-buffers paste-buffer respawn-pane display-message markdown
        browser help
    )
    print -l $cmds
}

